# Copy to .env and fill in. Never commit .env.

# --- Required ---
TELEGRAM_BOT_TOKEN=
# Capture channel id (starts with -100)
TELEGRAM_CHAT_ID=
# Review chat: Meera's 1:1 chat with the bot (or a private Drafts group)
TELEGRAM_REVIEW_CHAT_ID=
# Only this Telegram user may press review buttons or run admin commands
MEERA_USER_ID=
GEMINI_API_KEY=

# --- Optional (defaults shown) ---
TRIAGE_MODEL=gemini-3.5-flash-lite
DRAFT_MODEL=gemini-3.5-flash
# Second-pass fact check of every draft
QA_MODEL=gemini-3.5-flash
TRANSCRIBE_MODEL=gemini-3.5-flash
DB_PATH=skinstinct.db
TIMEZONE=Asia/Kolkata
# Notes are processed on arrival; this sweep retries anything that failed
SWEEP_INTERVAL_MINUTES=60
# Voice transcripts with more [unclear] words than this share go to human review
TRANSCRIPT_MAX_UNCLEAR_RATIO=0.2
# Regenerate presses allowed per note
MAX_REGENERATIONS=3
# Weighted publishability score 0-10; only notes scoring strictly ABOVE this are drafted
TRIAGE_THRESHOLD=8
# Notes shorter than this are rejected without a model call
TRIAGE_MIN_WORDS=12
# Google News RSS context window
NEWS_MAX_AGE_DAYS=14
NEWS_MAX_ITEMS=2
DRAFT_MIN_CHARS=200
DRAFT_MAX_CHARS=3000

# --- Production only (leave empty locally to use long-polling) ---
# Public HTTPS URL of the deployed service, e.g. https://skinstinct.up.railway.app
PUBLIC_URL=
# 16-256 chars of A-Z a-z 0-9 _ - ; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Most platforms set PORT themselves
PORT=8080
